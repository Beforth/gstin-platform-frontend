# SITE_ADDRESS: "localhost" (self-signed HTTPS), a real domain (automatic Let's Encrypt), or ":80" (plain HTTP,
# when another load balancer terminates TLS). BACKEND_URL: where the API lives.
{
	# The admin API is not needed in production. Turning it off also removes an unauthenticated control port.
	admin off
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API, accounts and the dashboard API go to the backend. Caddy passes the browser's Host header through
	# unchanged and adds X-Forwarded-For/-Proto/-Host: exactly what the backend's CSRF and rate limits expect.
	@api path /api /api/* /auth /auth/* /console /console/* /v1 /v1/*
	handle @api {
		reverse_proxy {$BACKEND_URL:http://backend:3001} {
			# a slow provider or a human typing a CAPTCHA must not be cut off mid-request
			transport http {
				response_header_timeout 60s
			}
		}
	}

	# Everything else is the single-page app. Client-side routes (no file extension) fall back to index.html;
	# a missing asset stays a real 404.
	handle {
		root * /srv
		@spa {
			not file
			not path_regexp \.[A-Za-z0-9]+$
		}
		rewrite @spa /index.html

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		file_server
	}
}

# Container health check target. Bound to the container's loopback only, never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
